# Q1: Cross-Party Co-Authorship Network
#
# Advantage: Graph traversal (multi-hop pattern matching)
#
# Finds pairs of MPs from different parties who co-author initiatives
# together most frequently. In a relational model this requires joining
# authorship tables, mandate tables, and party tables across multiple
# bridge tables. In SPARQL it is a single connected pattern.
#
# Path: MP → hasAuthor(initiative) → other MP
#       → mandate → membership → isMemberOf → party
#
PREFIX m4s: <http://purl.org/map4scrutiny-core#>
PREFIX polis-ini: <http://purl.org/polis/ar/initiatives#>
PREFIX polis-core: <http://purl.org/polis/ar/core#>
PREFIX polis-graph: <http://purl.org/polis/ar/graph#>
PREFIX ocd: <http://dati.camera.it/ocd/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT ?mp1Name ?mp2Name ?party1Acronym ?party2Acronym (COUNT(DISTINCT ?initiative) AS ?coauthoredInitiatives)
WHERE {
  ?initiative polis-ini:hasAuthor ?mp1, ?mp2 .
  FILTER (STR(?mp1) < STR(?mp2))

  ?mp1 a m4s:Parliamentarian ; foaf:name ?mp1Name ;
       ocd:rif_mandatoCamera [ polis-core:hasMembership [ polis-core:isMemberOf ?party1 ] ] .
  ?mp2 a m4s:Parliamentarian ; foaf:name ?mp2Name ;
       ocd:rif_mandatoCamera [ polis-core:hasMembership [ polis-core:isMemberOf ?party2 ] ] .

  ?party1 qudt:acronym ?party1Acronym .
  ?party2 qudt:acronym ?party2Acronym .

  FILTER (?party1 != ?party2)
}
GROUP BY ?mp1Name ?mp2Name ?party1Acronym ?party2Acronym
ORDER BY DESC(?coauthoredInitiatives)
LIMIT 30
