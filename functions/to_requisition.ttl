@prefix fno:  <https://w3id.org/function/ontology#> .
@prefix fnom: <https://w3id.org/function/vocabulary/mapping#> .
@prefix fnoi: <https://w3id.org/function/vocabulary/implementation#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/Functions#> .

:toRequisition a fno:Function ;
    fno:name "toRequisition" ;
    fno:expects ( :inputRequisitionParam ) ;
    fno:returns ( :outputRequisitionParam ) .

:inputRequisitionParam a fno:Parameter ;
    fno:predicate :inputRequisition ;
    fno:name "inputRequisition" ;
    fno:description "Input string to convert to requisition type." ;
    fno:type xsd:string ;
    fno:required "true"^^xsd:boolean .

:outputRequisitionParam a fno:Output ;
    fno:predicate :output ;
    fno:name "outputRequisition" ;
    fno:description "Converted requisition type." ;
    fno:type xsd:string .

:toRequisitionImpl a fnoi:JavaClass ;
    doap:download-page "build/libs/orwell-1.0-SNAPSHOT.jar" ;
    fnoi:class-name "rdf.mapping.functions.ToRequisition" .

:toRequisitionMapping a fno:Mapping ;
    fno:function :toRequisition ;
    fno:implementation :toRequisitionImpl ;
    fno:methodMapping [ a fnom:StringMethodMapping ; fnom:method-name "toRequisition" ]
.