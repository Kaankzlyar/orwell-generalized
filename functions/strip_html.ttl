 @prefix fno:  <https://w3id.org/function/ontology#> .
  @prefix fnom: <https://w3id.org/function/vocabulary/mapping#> .
  @prefix fnoi: <https://w3id.org/function/vocabulary/implementation#> .
  @prefix doap: <http://usefulinc.com/ns/doap#> .
  @prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
  @prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
  @prefix :     <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/Functions#> .

  :stripHtml a fno:Function ;
      fno:name "stripHtml" ;
      fno:expects ( :stripHtmlValueParam ) ;
      fno:returns ( :stripHtmlOutputParam ) .

  :stripHtmlValueParam a fno:Parameter ;
      fno:predicate grel:valueParameter ;
      fno:name "value" ;
      fno:description "Text that may contain HTML tags and entities." ;
      fno:type xsd:string ;
      fno:required "true"^^xsd:boolean .

  :stripHtmlOutputParam a fno:Output ;
      fno:predicate :output ;
      fno:name "output" ;
      fno:description "Text without tags, entities unescaped and trimmed; null when empty." ;
      fno:type xsd:string .

  :stripHtmlImpl a fnoi:JavaClass ;
      doap:download-page "build/libs/orwell-1.0-SNAPSHOT.jar" ;
      fnoi:class-name "core.rdf.mapping.functions.StripHtml" .

  :stripHtmlMapping a fno:Mapping ;
      fno:function :stripHtml ;
      fno:implementation :stripHtmlImpl ;
      fno:methodMapping [ a fnom:StringMethodMapping ; fnom:method-name "stripHtml" ]