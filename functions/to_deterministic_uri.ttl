@prefix fno:  <https://w3id.org/function/ontology#> .
@prefix fnom: <https://w3id.org/function/vocabulary/mapping#> .
@prefix fnoi: <https://w3id.org/function/vocabulary/implementation#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/Functions#> .

:toDeterministicUri a fno:Function ;
    fno:name "toDeterministicUri" ;
    fno:expects (
        :entityPrefixParam
        :sourceSystemParam
        :key1Param
        :key2Param
        :key3Param
        :key4Param
        :key5Param
    ) ;
    fno:returns ( :outputUriParam ) .

:entityPrefixParam a fno:Parameter ;
    fno:predicate :entityPrefix ;
    fno:name "entityPrefix" ;
    fno:type xsd:string ;
    fno:required "true"^^xsd:boolean .

:sourceSystemParam a fno:Parameter ;
    fno:predicate :sourceSystem ;
    fno:name "sourceSystem" ;
    fno:type xsd:string ;
    fno:required "true"^^xsd:boolean .

:key1Param a fno:Parameter ;
    fno:predicate :key1 ;
    fno:name "key1" ;
    fno:type xsd:string ;
    fno:required "false"^^xsd:boolean .

:key2Param a fno:Parameter ;
    fno:predicate :key2 ;
    fno:name "key2" ;
    fno:type xsd:string ;
    fno:required "false"^^xsd:boolean .

:key3Param a fno:Parameter ;
    fno:predicate :key3 ;
    fno:name "key3" ;
    fno:type xsd:string ;
    fno:required "false"^^xsd:boolean .

:key4Param a fno:Parameter ;
    fno:predicate :key4 ;
    fno:name "key4" ;
    fno:type xsd:string ;
    fno:required "false"^^xsd:boolean .

:key5Param a fno:Parameter ;
    fno:predicate :key5 ;
    fno:name "key5" ;
    fno:type xsd:string ;
    fno:required "false"^^xsd:boolean .

:outputUriParam a fno:Output ;
    fno:predicate :output ;
    fno:name "output" ;
    fno:type xsd:string .

:toDeterministicUriImpl a fnoi:JavaClass ;
    doap:download-page "build/libs/orwell-1.0-SNAPSHOT.jar" ;
    fnoi:class-name "rdf.mapping.functions.ToDeterministicUri" .

:toDeterministicUriMapping a fno:Mapping ;
    fno:function :toDeterministicUri ;
    fno:implementation :toDeterministicUriImpl ;
    fno:methodMapping [ a fnom:StringMethodMapping ; fnom:method-name "toDeterministicUri" ]
.