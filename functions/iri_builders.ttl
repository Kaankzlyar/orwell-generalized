@prefix fno:  <https://w3id.org/function/ontology#> .
@prefix fnom: <https://w3id.org/function/vocabulary/mapping#> .
@prefix fnoi: <https://w3id.org/function/vocabulary/implementation#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/Functions#> .

:prefixedIri a fno:Function ;
    fno:name "prefixedIri" ;
    fno:expects ( :prefixParam :valueParam ) ;
    fno:returns ( :iriOutputParam ) .

:prefixParam a fno:Parameter ;
    fno:predicate :prefix ;
    fno:name "prefix" ;
    fno:description "IRI prefix to prepend." ;
    fno:type xsd:string ;
    fno:required "true"^^xsd:boolean .

:valueParam a fno:Parameter ;
    fno:predicate :value ;
    fno:name "value" ;
    fno:description "Value to append to the prefix when present." ;
    fno:type xsd:string ;
    fno:required "true"^^xsd:boolean .

:iriOutputParam a fno:Output ;
    fno:predicate :output ;
    fno:name "output" ;
    fno:description "Built IRI string." ;
    fno:type xsd:string .

:parliamentaryActivityIri a fno:Function ;
    fno:name "parliamentaryActivityIri" ;
    fno:expects ( :activityTypeParam :activityIdParam :legislatureParam ) ;
    fno:returns ( :iriOutputParam ) .

:activityTypeParam a fno:Parameter ;
    fno:predicate :activityType ;
    fno:name "activityType" ;
    fno:description "Activity type used in the parliamentary activity IRI." ;
    fno:type xsd:string ;
    fno:required "true"^^xsd:boolean .

:activityIdParam a fno:Parameter ;
    fno:predicate :activityId ;
    fno:name "activityId" ;
    fno:description "Activity identifier used in the parliamentary activity IRI." ;
    fno:type xsd:string ;
    fno:required "true"^^xsd:boolean .

:legislatureParam a fno:Parameter ;
    fno:predicate :legislature ;
    fno:name "legislature" ;
    fno:description "Legislature identifier used in the parliamentary activity IRI." ;
    fno:type xsd:string ;
    fno:required "true"^^xsd:boolean .

:iriBuilderImpl a fnoi:JavaClass ;
    doap:download-page "build/libs/orwell-1.0-SNAPSHOT.jar" ;
    fnoi:class-name "rdf.mapping.functions.IriBuilder" .

:prefixedIriMapping a fno:Mapping ;
    fno:function :prefixedIri ;
    fno:implementation :iriBuilderImpl ;
    fno:methodMapping [ a fnom:StringMethodMapping ; fnom:method-name "prefixedIri" ]
.

:parliamentaryActivityIriMapping a fno:Mapping ;
    fno:function :parliamentaryActivityIri ;
    fno:implementation :iriBuilderImpl ;
    fno:methodMapping [ a fnom:StringMethodMapping ; fnom:method-name "parliamentaryActivityIri" ]
.
