@prefix fno:  <https://w3id.org/function/ontology#> .
@prefix fnom: <https://w3id.org/function/vocabulary/mapping#> .
@prefix fnoi: <https://w3id.org/function/vocabulary/implementation#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/Functions#> .

:toHabilitationLevel a fno:Function ;
    fno:name "toHabilitationLevel" ;
    fno:expects ( :inputHabilitationLevelParam ) ;
    fno:returns ( :outputHabilitationLevelParam ) .

:inputHabilitationLevelParam a fno:Parameter ;
    fno:predicate :inputHabilitationLevel ;
    fno:name "inputHabilitationLevel" ;
    fno:description "Input string to convert to habilitation type." ;
    fno:type xsd:string ;
    fno:required "true"^^xsd:boolean .

:outputHabilitationLevelParam a fno:Output ;
    fno:predicate :output ;
    fno:name "outputHabilitationLevel" ;
    fno:description "Converted habilitation type." ;
    fno:type xsd:string .

:toHabilitationLevelImpl a fnoi:JavaClass ;
    doap:download-page "build/libs/orwell-1.0-SNAPSHOT.jar" ;
    fnoi:class-name "rdf.mapping.functions.ToHabilitationLevel" .

:toHabilitationLevelMapping a fno:Mapping ;
    fno:function :toHabilitationLevel ;
    fno:implementation :toHabilitationLevelImpl ;
    fno:methodMapping [ a fnom:StringMethodMapping ; fnom:method-name "toHabilitationLevel" ]
.