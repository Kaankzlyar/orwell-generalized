@prefix rr:       <http://www.w3.org/ns/r2rml#> .
@prefix rml:      <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:       <http://semweb.mmlab.be/ns/ql#> .
@prefix fnml:     <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno:      <https://w3id.org/function/ontology#> .
@prefix ex:       <http://example.org/fn/> .
@prefix schema:   <https://schema.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix :         <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology-InfoBase/> .
@base             <http://example.org/mappings/> .

<#LegislatureMap>

  rml:logicalSource [
    rml:source "data/" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "/Legislatura/DetalheLegislatura"
  ] ;

  rr:subjectMap [
    rr:template "http://example.org/legislature/{id}" ; #URI
    rr:class :Legislature
  ] ;

  rr:predicateObjectMap [
    rr:predicate schema:startDate ;
    rr:objectMap [
      rml:reference "dtini" ;
      rr:datatype xsd:date
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate schema:endDate ;
    rr:objectMap [
      rml:reference "dtfim" ;
      rr:datatype xsd:date
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate dcterms:identifier ;
    rr:objectMap [
      rml:reference "id" ;
      rr:datatype xsd:integer
    ]
  ]
  .

<#ElectoralCircleMap>

  rml:logicalSource [
    rml:source "data/" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "/Legislatura/CirculosEleitorais/pt_ar_wsgode_objectos_DadosCirculoEleitoralList"
  ] ;

  rr:subjectMap [
    rr:template "http://example.org/electoralCircle/{cpId}" ;
    rr:class :ElectoralCircle
  ] ;

  rr:predicateObjectMap [
    rr:predicate owl:sameAs ;
    rr:objectMap [
      rr:termType rr:IRI ;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:objectMap [ rr:constant ex:reconciliate ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate ex:query ;
          rr:objectMap [ rml:reference "cpDes" ]
        ]
      ]
    ]
  ] 
  .
