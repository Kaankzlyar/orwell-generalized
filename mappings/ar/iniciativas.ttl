@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix rml:    <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:     <http://semweb.mmlab.be/ns/ql#> .
@prefix fnml:   <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno:    <https://w3id.org/function/ontology#> .
@prefix pofn:   <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/Functions#> . # TODO: Update URI to match where the pofn file is hosted
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml:    <http://www.w3.org/XML/1998/namespace> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dbo:    <http://dbpedia.org/ontology/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix ocd:    <http://dati.camera.it/ocd/> .
@prefix m4s:    <http://purl.org/map4scrutiny-core#> .
@prefix schema: <https://schema.org/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix sem: <http://semanticweb.cs.vu.nl/2009/11/sem/> .
@prefix pe:     <https://ukparliament.github.io/ontologies/election/election-ontology.ttl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix polis-ini:    <http://purl.org/polis/ar/initiatives#> .
@prefix polis-bio:    <http://purl.org/polis/ar/biographic#> .
@prefix polis-core:   <http://purl.org/polis/ar/core#> .
@prefix polis-graph:  <http://purl.org/polis/ar/graph#> .

<#InitiativeMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfPt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/Pt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut" ;
    ] ;

    rr:subjectMap [
        rr:class polis-ini:Initiative ;
        rr:template "http://purl.org/polis/ar/graph#Initiative_{IniId}"
    ] ;

    # Initiative Type
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:toClass ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:entityName ;
                    rr:objectMap [ rml:reference "IniDescTipo" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:className ;
                    rr:objectMap [ rr:constant "initiativeType" ]
                ]
            ]
        ]
    ] ;

    # Identifier
    rr:predicateObjectMap [
        rr:predicate polis-core:identifier ;
        rr:objectMap [
            rml:reference "IniId";
            rr:datatype xsd:string
        ]
    ] ;

    # Title
    rr:predicateObjectMap [
        rr:predicate dct:title ;
        rr:objectMap [
            rr:datatype xsd:string ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "IniTitulo" ]
                ]
            ]
        ]
    ] ;

    # Number
    rr:predicateObjectMap [
        rr:predicate dbo:number ;
        rr:objectMap [
            rml:reference "IniNr";
            rr:datatype xsd:nonNegativeInteger
        ]
    ] ;

    # Substitution Details
    rr:predicateObjectMap [
        rr:predicate polis-ini:textSubstitutionDetails ;
        rr:objectMap [
            rr:datatype xsd:string ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "IniTextoSubstCampo" ]
                ]
            ]
        ]
    ] ;

    # Legislature
    rr:predicateObjectMap [
        rr:predicate polis-core:belongsToLegislature ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/graph#{IniLeg}" ;
            rr:termType rr:IRI ;
        ]
    ] ;

    # Legislative Session
    rr:predicateObjectMap [
        rr:predicate polis-core:belongsToLegislativeSession ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/graph#Session_{IniSel}_of_{IniLeg}" ;
            rr:termType rr:IRI ;
        ]
    ] ;

    # Content
    rr:predicateObjectMap [
        rr:predicate polis-ini:hasContent ;
        rr:objectMap [ 
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:hashIri ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:prefix ;
                    rr:objectMap [ rr:constant "urn:content:" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:elements ;
                    rr:objectMap [ rml:reference "IniLinkTexto" ]
                ]
            ]
        ]
    ] ;

    # Proponent Type
    rr:predicateObjectMap [
        rr:predicate polis-ini:proponentType ;
        rr:objectMap [
            rr:datatype xsd:string ;
            rml:reference "IniAutorOutros/nome"
        ]
    ] ;

    # Other Proponent
    rr:predicateObjectMap [
        rr:predicate polis-ini:hasProponent ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:toClass ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:entityName ;
                    rr:objectMap [ rml:reference "IniAutorOutros/nome" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:className ;
                    rr:objectMap [ rr:constant "otherProponent" ]
                ]
            ]
        ]
    ] ;

    # Other Proponent (Government) 
    rr:predicateObjectMap [
        rr:predicate polis-ini:hasProponent ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:controls_if ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:bool_b ;
                    rr:objectMap [
                        fnml:functionValue [
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant pofn:stringEquals ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:string1 ;
                                rr:objectMap [ rml:reference "IniAutorOutros/sigla" ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:string2 ;
                                rr:objectMap [ rr:constant "V" ] # V is the sigla for the government in the IniAutorOutros field
                            ]
                        ]
                    ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:any_true ;
                    rr:objectMap [
                        rr:template "http://purl.org/polis/ar/graph#Government_{IniLeg}" ;
                        rr:termType rr:IRI
                    ]
                ]
            ]
        ] ;
    ] ;

    # Other Proponent (Commission)
    rr:predicateObjectMap [
        rr:predicate polis-ini:hasProponent ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:stringConcat ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:leftPart ;
                    rr:objectMap [ rr:constant "http://purl.org/polis/ar/graph#Commission_" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:rightPart ;
                    rr:objectMap [
                        fnml:functionValue [
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant pofn:lookup ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:lookupTable ;
                                rr:objectMap [ rr:constant "CommissionInformation" ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:lookupValue ;
                                rr:objectMap [ rml:reference "IniAutorOutros/iniAutorComissao" ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:lookupValue ;
                                rr:objectMap [ rml:reference "IniLeg" ]
                            ]
                        ] ;
                    ]
                ]
            ] ;
        ]
    ] ;
    .

<#ContentMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfPt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/Pt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/IniLinkTexto" ;
    ] ;

    rr:subjectMap [
        rr:class bibo:Document ;
        rr:termType rr:IRI ;
        fnml:functionValue [
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant pofn:hashIri ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:prefix ;
                rr:objectMap [ rr:constant "urn:content:" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "." ]
            ]
        ]
    ] ;

    # URL
    rr:predicateObjectMap [
        rr:predicate schema:url ;
        rr:objectMap [ rml:reference "." ]
    ] ;
    .

<#OriginatedMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfPt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/Pt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/IniciativasOriginadas/pt_gov_ar_objectos_iniciativas_DadosGeraisOut" ;
    ] ;

    rr:subjectMap [
        rr:class polis-ini:Initiative ;
        rr:template "http://purl.org/polis/ar/graph#Initiative_{../../IniId}"
    ] ;

    # Led To
    rr:predicateObjectMap [
        rr:predicate polis-ini:ledTo ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/graph#Initiative_{id}" ;
            rr:termType rr:IRI ;
        ]
    ] ;
    . 

<#OriginatedFromInitiativeMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfPt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/Pt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/IniciativasOrigem/pt_gov_ar_objectos_iniciativas_DadosGeraisOut" ;
    ] ;

    rr:subjectMap [
        rr:class polis-ini:Initiative ;
        rr:template "http://purl.org/polis/ar/graph#Initiative_{../../IniId}"
    ] ;

    # Grew Out Of
    rr:predicateObjectMap [
        rr:predicate polis-ini:grewOutOf ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/graph#Initiative_{id}" ;
            rr:termType rr:IRI ;
        ]
    ] ;
    .

<#InitiativeAuthorParliamentarianMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfPt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/Pt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/IniAutorDeputados/pt_gov_ar_objectos_iniciativas_AutoresDeputadosOut" ;
    ] ;

    rr:subjectMap [
        rr:class polis-ini:Initiative ;
        rr:template "http://purl.org/polis/ar/graph#Initiative_{../../IniId}"
    ] ;

    # Authored
    rr:predicateObjectMap [
        rr:predicate polis-ini:hasAuthor ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/graph#Parliamentarian_{idCadastro}.0" ;
            rr:termType rr:IRI ;
        ]
    ] ;

    # Proponent (if IniAutorOutros/sigla is "D")
    rr:predicateObjectMap [
        rr:predicate polis-ini:hasProponent ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:controls_if ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:bool_b ;
                    rr:objectMap [
                        fnml:functionValue [
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant pofn:stringEquals ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:string1 ;
                                rr:objectMap [ rml:reference "../../IniAutorOutros/sigla" ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:string2 ;
                                rr:objectMap [ rr:constant "D" ]
                            ]
                        ]
                    ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:any_true ;
                    rr:objectMap [
                        rr:template "http://purl.org/polis/ar/graph#Parliamentarian_{idCadastro}.0" ;
                        rr:termType rr:IRI
                    ]
                ]
            ]
        ]
    ]
    .

<#InitiativeProponentPartyMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfPt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/Pt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/IniAutorGruposParlamentares/pt_gov_ar_objectos_AutoresGruposParlamentaresOut" ;
    ] ;

    rr:subjectMap [
        rr:class polis-ini:Initiative ;
        rr:template "http://purl.org/polis/ar/graph#Initiative_{../../IniId}"
    ] ;

    # Authored
    rr:predicateObjectMap [
        rr:predicate polis-ini:hasProponent ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/graph#ParliamentaryGroup_{GP}_of_{../../IniLeg}" ;
            rr:termType rr:IRI ;
        ]
    ] ;
    .

<#RegionalLegislativeAssemblyMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfPt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/Pt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/IniAutorOutros" ;
    ] ;

    rr:subjectMap [
        rr:class polis-ini:RegionalLegislativeAssembly ;
        fnml:functionValue [
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant pofn:toClass ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:entityName ;
                rr:objectMap [ rml:reference "nome" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:className ;
                rr:objectMap [ rr:constant "regionalLegislativeAssembly" ]
            ]
        ]
    ] ;

    # Name
    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [ 
            rml:reference "nome" ;
            rr:datatype xsd:string ;
        ]
    ] ;

    # Location
    rr:predicateObjectMap [
        rr:predicate sem:hasPlace ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:stringConcat ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:leftPart ;
                    rr:objectMap [ rr:constant "http://purl.org/polis/ar/graph#Place_" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:rightPart ;
                    rr:objectMap [
                        fnml:functionValue [
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant pofn:regionalAssemblyLocation ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:inputString ;
                                rr:objectMap [ 
                                    rml:reference "nome" 
                                ]
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ] ;
    .

<#PlaceMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfPt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/Pt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/IniAutorOutros" ;
    ] ;

    rr:subjectMap [
        rr:class sem:Place ;
        rr:termType rr:IRI ;
        fnml:functionValue [
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant pofn:stringConcat ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:leftPart ;
                rr:objectMap [ rr:constant "http://purl.org/polis/ar/graph#Place_" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:rightPart ;
                rr:objectMap [
                    fnml:functionValue [
                        rr:predicateObjectMap [
                            rr:predicate fno:executes ;
                            rr:objectMap [ rr:constant pofn:regionalAssemblyLocation ]
                        ] ;
                        rr:predicateObjectMap [
                            rr:predicate pofn:inputString ;
                            rr:objectMap [ 
                                rml:reference "nome" 
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ] ;

    # Name
    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [ 
            rr:datatype xsd:string ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:regionalAssemblyLocation ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:inputString ;
                    rr:objectMap [ 
                        rml:reference "nome" 
                    ]
                ]
            ]
        ]
    ] ;

    # Same as
    rr:predicateObjectMap [
        rr:predicate owl:sameAs ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:reconciliate ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:query ;
                    rr:objectMap [ 
                        rr:datatype xsd:string ;
                        fnml:functionValue [
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant pofn:regionalAssemblyLocation ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:inputString ;
                                rr:objectMap [ 
                                    rml:reference "nome" 
                                ]
                            ]
                        ]
                    ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:type ;
                    rr:objectMap [ rr:constant "Q2221906" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:limit ;
                    rr:objectMap [ rr:constant "1"]
                ]
            ]
        ]
    ] 
    .

<#PetitionMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfPt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/Pt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/Peticoes/pt_gov_ar_objectos_iniciativas_DadosGeraisOut" ;
    ] ;

    rr:subjectMap [
        rr:class polis-ini:Petition ;
        rr:template "http://purl.org/polis/ar/graph#Petition_{id}"
    ] ;

    # Identifier
    rr:predicateObjectMap [
        rr:predicate polis-core:identifier ;
        rr:objectMap [ 
            rml:reference "id" ;
            rr:datatype xsd:string
        ]
    ] ;

    # Number
    rr:predicateObjectMap [
        rr:predicate dbo:number ;
        rr:objectMap [ 
            rml:reference "numero" ;
            rr:datatype xsd:nonNegativeInteger
        ]
    ] ;

    # Title
    rr:predicateObjectMap [
        rr:predicate dct:title ;
        rr:objectMap [
            rr:datatype xsd:string ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "assunto" ]
                ]
            ] ;
        ]
    ] ;

    # Legislature
    rr:predicateObjectMap [
        rr:predicate polis-core:belongsToLegislature ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/graph#{legislatura}" ;
            rr:termType rr:IRI 
        ]
    ] ;

    # Legislative Session
    rr:predicateObjectMap [
        rr:predicate polis-core:belongsToLegislativeSession ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/graph#Session_{sessao}_of_{legislatura}" ;
            rr:termType rr:IRI
        ]
    ]
    .

<#InitiativePetitionRelationMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfPt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/Pt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/Peticoes/pt_gov_ar_objectos_iniciativas_DadosGeraisOut" ;
    ] ;

    rr:subjectMap [
        rr:class polis-ini:Initiative ;
        rr:template "http://purl.org/polis/ar/graph#Initiative_{../../IniId}"
    ] ;

    # Petition
    rr:predicateObjectMap [
        rr:predicate polis-ini:hasPetition ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:stringConcat ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:leftPart ;
                    rr:objectMap [ rr:constant "http://purl.org/polis/ar/graph#Petition_" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:rightPart ;
                    rr:objectMap [ rml:reference "Peticoes/pt_gov_ar_objectos_iniciativas_DadosGeraisOut/id" ]
                ]
            ]
        ]
    ]
    .

<#AnnexMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
