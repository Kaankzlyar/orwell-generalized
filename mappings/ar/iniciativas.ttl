@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix rml:    <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:     <http://semweb.mmlab.be/ns/ql#> .
@prefix fnml:   <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno:    <https://w3id.org/function/ontology#> .
@prefix pofn:   <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/Functions#> . # TODO: Update URI to match where the pofn file is hosted
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml:    <http://www.w3.org/XML/1998/namespace> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dbo:    <http://dbpedia.org/ontology/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix ocd:    <http://dati.camera.it/ocd/> .
@prefix m4s:    <https://purl.org/map4scrutiny-core#> .
@prefix schema: <https://schema.org/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix pe:     <https://ukparliament.github.io/ontologies/election/election-ontology.ttl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix polis-ini:    <http://purl.org/polis/ar/initiatives#> .
@prefix polis-bio:    <http://purl.org/polis/ar/biographic#> .
@prefix polis-core:   <http://purl.org/polis/ar/core#> .
@prefix polis-graph:  <http://purl.org/polis/ar/graph#> .

<#InitiativeMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfPt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut/Pt_gov_ar_objectos_iniciativas_DetalhePesquisaIniciativasOut" ;
    ] ;

    rr:subjectMap [
        rr:class polis-ini:Initiative ;
        rr:template "http://purl.org/polis/ar/graph#Initiative_{IniId}"
    ] ;

    # Initiative Type
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:toClass ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:entityName ;
                    rr:objectMap [ rml:reference "IniDescTipo" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:className ;
                    rr:objectMap [ rr:constant "initiativeType" ]
                ]
            ]
        ]
    ] ;

    # Identifier
    rr:predicateObjectMap [
        rr:predicate polis-core:identifier ;
        rr:objectMap [
            rml:reference "IniId";
            rr:datatype xsd:string
        ]
    ] ;

    # Title
    rr:predicateObjectMap [
        rr:predicate dct:title ;
        rr:objectMap [
            rr:datatype xsd:string ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "IniTitulo" ]
                ]
            ]
        ]
    ] ;

    # Number
    rr:predicateObjectMap [
        rr:predicate dbo:number ;
        rr:objectMap [
            rml:reference "IniNr";
            rr:datatype xsd:nonNegativeInteger
        ]
    ] ;

    # Substitution Details
    rr:predicateObjectMap [
        rr:predicate polis-ini:textSubstitutionDetails ;
        rr:objectMap [
            rr:datatype xsd:string ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "IniTextoSubstCampo" ]
                ]
            ]
        ]
    ] ;

    # Legislature
    rr:predicateObjectMap [
        rr:predicate polis-core:belongsToLegislature ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/graph#{IniLeg}" ;
            rr:termType rr:IRI ;
        ]
    ] ;

    # Legislative Session
    rr:predicateObjectMap [
        rr:predicate polis-core:belongsToLegislativeSession ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/graph#Session_{IniSel}_of_{IniLeg}" ;
            rr:termType rr:IRI ;
        ]
    ] ;
    .