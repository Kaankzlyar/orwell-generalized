                ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [
                    rml:reference "ActSelLg" ;
                ]
            ] ;
        ]
    ] ;

    # Type
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/mp-activity#{ActTp}" ;
