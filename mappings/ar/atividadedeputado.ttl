@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix rml:    <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:     <http://semweb.mmlab.be/ns/ql#> .
@prefix fnml:   <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno:    <https://w3id.org/function/ontology#> .
@prefix pofn:   <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/Functions#> . # TODO: Update URI to match where the pofn file is hosted
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml:    <http://www.w3.org/XML/1998/namespace> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dbo:    <http://dbpedia.org/ontology/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix ocd:    <http://dati.camera.it/ocd/> .
@prefix m4s:    <https://purl.org/map4scrutiny-core#> .
@prefix schema: <https://schema.org/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix prov:   <https://www.w3.org/ns/prov-o#> .
@prefix pe:     <https://ukparliament.github.io/ontologies/election/election-ontology.ttl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix sem: <http://semanticweb.cs.vu.nl/2009/11/sem/> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix polis-ini:    <http://purl.org/polis/ar/initiatives#> .
@prefix polis-bio:    <http://purl.org/polis/ar/biographic#> .
@prefix polis-core:   <http://purl.org/polis/ar/core#> .
@prefix polis-mpact:  <http://purl.org/polis/ar/mp-activity#> .
@prefix polis-graph:  <http://purl.org/polis/ar/graph#> .


<#CommissionMap> a rr:TriplesMap ;
    
    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/Cms/ComissoesOut" ;
    ] ;

    rr:subjectMap [
        rr:class polis-core:Commission ;
        rr:termType rr:IRI ;
        fnml:functionValue [
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant pofn:stringConcat ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:leftPart ;
                rr:objectMap [ rr:constant "http://purl.org/polis/ar/graph#Commission_" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:rightPart ;
                rr:objectMap [
                    fnml:functionValue [
                        rr:predicateObjectMap [
                            rr:predicate fno:executes ;
                            rr:objectMap [ rr:constant pofn:lookup ]
                        ] ;
                        rr:predicateObjectMap [
                            rr:predicate pofn:lookupTable ;
                            rr:objectMap [ rr:constant "CommissionInformation" ]
                        ] ;
                        rr:predicateObjectMap [
                            rr:predicate pofn:lookupValue ;
                            rr:objectMap [ rml:reference "CmsNo" ]
                        ] ;
                        rr:predicateObjectMap [
                            rr:predicate pofn:lookupValue ;
                            rr:objectMap [ rml:reference "CmsLg" ]
                        ]
                    ] ;
                ]
            ]
        ] ;
    ] ;
    .

<#ParliamentarianRequisitionRelationMap> a rr:TriplesMap ;
    
    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/Req/RequerimentosAtivDepOut" ;
    ] ;

    rr:subjectMap [
        rr:template "http://purl.org/polis/ar/graph#Parliamentarian_{../../../../Deputado/DepCadId}" ;
        rr:class m4s:Parliamentarian
    ] ;

    rr:predicateObjectMap [
        rr:predicate polis-mpact:didRequisition ;
        rr:objectMap [
            rr:template "http://purl.org/polis/ar/graph#Requisition_{ReqId}" ;
            rr:termType rr:IRI ;
        ]
    ] ;
    .

<#RequisitionMap> a rr:TriplesMap ;
    
    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/Req/RequerimentosAtivDepOut" ;
    ] ;

    rr:subjectMap [
        rr:template "http://purl.org/polis/ar/graph#Requisition_{ReqId}" ;
        rr:class ocd:richiestaParere
    ] ;

    # Requisition Type
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:toClass ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:entityName ;
                    rr:objectMap [ rml:reference "ReqPerTp" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:className ;
                    rr:objectMap [ rr:constant "requisitionType" ]
                ]
            ]
        ]
    ] ;

    # Identifier
    rr:predicateObjectMap [
        rr:predicate polis-core:identifier ;
        rr:objectMap [ 
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "ReqId" ]
                ]
            ] ;
            rr:datatype xsd:string
        ]
    ] ;

    # Number
    rr:predicateObjectMap [
        rr:predicate dbo:number ;
        rr:objectMap [ 
            rml:reference "ReqNr" ;
            rr:datatype xsd:nonNegativeInteger
        ]
    ] ;

    # Subject
    rr:predicateObjectMap [
        rr:predicate dct:subject ;
        rr:objectMap [ 
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "ReqAs" ]
                ]
            ] ;
            rr:datatype xsd:string
        ]
    ] ;

    # Date
    rr:predicateObjectMap [
        rr:predicate dct:date ;
        rr:objectMap [
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:toXsdDateTime ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:inputDateTime ;
                    rr:objectMap [ rml:reference "ReqDt" ]
                ]
            ] ;
            rr:datatype xsd:dateTime
        ]
    ] ;

    # Legislature
    rr:predicateObjectMap [
        rr:predicate polis-core:belongsToLegislature ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/graph#{ReqLg}" ;
            rr:termType rr:IRI ;
        ]
    ] ;

    # Legislative Session
    rr:predicateObjectMap [
        rr:predicate polis-core:belongsToLegislativeSession ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/graph#Session_{ReqSl}_of_{ReqLg}" ;
            rr:termType rr:IRI ;
        ]
    ] ;

    # Public Entity
    rr:predicateObjectMap [
        rr:predicate polis-mpact:toPublicEntityType ;
        rr:objectMap [ 
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:stringConcat ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:leftPart ;
                    rr:objectMap [ rr:constant "http://purl.org/polis/ar/mp-activity#" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:rightPart ;
                    rr:objectMap [ rml:reference "ReqTp" ]
                ]
            ]
        ]
    ] ;
    .

<#ParliamentarianYPARelationMap> a rr:TriplesMap ;
    
    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/ParlamentoJovens/DadosDeputado" ;
    ] ;

    rr:subjectMap [
        rr:template "http://purl.org/polis/ar/graph#Parliamentarian_{../../../../Deputado/DepCadId}" ;
        rr:class m4s:Parliamentarian
    ] ;

    rr:predicateObjectMap [
        rr:predicate polis-mpact:didYouthParliamentActivity ;
        rr:objectMap [ 
            rr:parentTriplesMap <#YouthParliamentActivityMap> ;
        ]
    ] ;
    .

<#YouthParliamentActivityMap> a rr:TriplesMap ;
    
    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/ParlamentoJovens/DadosDeputado" ;
    ] ;

    rr:subjectMap [
        rr:termType rr:IRI ;
        rr:class polis-mpact:YouthParliamentActivity ;
        fnml:functionValue [
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant pofn:hashIri ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:prefix ;
                rr:objectMap [ rr:constant "urn:ypa:" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "Legislatura" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "Data" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "TipoReuniao" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "Estabelecimento" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "CirculoEleitoral" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "Sessao" ]
            ]
        ]
    ] ;

    # Date
    rr:predicateObjectMap [
        rr:predicate dct:date ;
        rr:objectMap [
            rml:reference "Data" ;
            rr:datatype xsd:date
        ] ;
    ] ;

    # Legislature
    rr:predicateObjectMap [
        rr:predicate polis-core:belongsToLegislature ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/graph#{Legislatura}" ;
            rr:termType rr:IRI ;
        ]
    ] ;

    # Meeting Type
    rr:predicateObjectMap [
        rr:predicate polis-mpact:meetingType ;
        rr:objectMap [ 
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "TipoReuniao" ]
                ]
            ] ;
            rr:datatype xsd:string ;
        ]
    ] ;

    # School
    rr:predicateObjectMap [
        rr:predicate polis-mpact:heldAt ;
        rr:objectMap [ 
            rr:parentTriplesMap <#SchoolMap> ;
        ]
    ] ;

    # Constituency
    rr:predicateObjectMap [
        rr:predicate polis-core:inConstituency ;
        rr:termType rr:IRI ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:stringConcat ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:leftPart ;
                    rr:objectMap [ rr:constant "http://purl.org/polis/ar/graph#Constituency_" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:rightPart ;
                    rr:objectMap [
                        fnml:functionValue [
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant pofn:normalize ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:inputString ;
                                rr:objectMap [ rml:reference "CirculoEleitoral" ]
                            ]
                        ] ;
                    ]
                ]
            ] ;
        ]
    ] ;
    .

<#SchoolMap> a rr:TriplesMap ;
    
    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/ParlamentoJovens/DadosDeputado" ;
    ] ;

    rr:subjectMap [
        rr:termType rr:IRI ;
        rr:class dbo:School ;
        fnml:functionValue [
            rr:termType rr:IRI ;
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant grel:array_join ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate grel:p_array_a ;
                rr:objectMap [ rr:constant "http://purl.org/polis/ar/graph#School_" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate grel:p_array_a ;
                rr:objectMap [
                    fnml:functionValue [
                        rr:predicateObjectMap [
                            rr:predicate fno:executes ;
                            rr:objectMap [ rr:constant pofn:normalize ]
                        ] ;
                        rr:predicateObjectMap [
                            rr:predicate pofn:inputString ;
                            rr:objectMap [ rml:reference "Estabelecimento" ]
                        ]
                    ] ;
                    rr:datatype xsd:string
                ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate grel:p_string_sep ;
                rr:objectMap [ rr:constant "" ]
            ]
        ] ;
    ] ;

    # Name
    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [ 
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "Estabelecimento" ]
                ]
            ] ;
            rr:datatype xsd:string
        ]
    ] ;

    # School Type
    rr:predicateObjectMap [
        rr:predicate polis-mpact:isSchoolType ;
        rr:objectMap [
        fnml:functionValue [
            rr:predicateObjectMap [
            rr:predicate fno:executes ;
            rr:objectMap [ rr:constant pofn:toClass ]
            ] ;
            rr:predicateObjectMap [
            rr:predicate pofn:entityName ;
            rr:objectMap [
                fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "Sessao" ]
                ]
                ]
            ]
            ] ;
            rr:predicateObjectMap [
            rr:predicate pofn:className ;
            rr:objectMap [
                rr:constant "schoolType" ;
                rr:datatype xsd:string
            ]
            ]
        ] ;
        rr:termType rr:IRI
        ]
    ] ;
    .

<#ParliamentarianFriendshipParliamentaryGroupRelationMap> a rr:TriplesMap ;
    
    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/Gpa/GruposParlamentaresAmizadeOut" ;
    ] ;

    rr:subjectMap [
        rr:template "http://purl.org/polis/ar/graph#Parliamentarian_{../../../../Deputado/DepCadId}" ;
        rr:class m4s:Parliamentarian
    ] ;

    rr:predicateObjectMap [
        rr:predicate polis-core:hasMembership ;
        rr:objectMap [ 
            rr:parentTriplesMap <#ParliamentarianFriendshipParliamentaryGroupMembershipMap> ;
        ]
    ] ;
    .

<#ParliamentarianFriendshipParliamentaryGroupMembershipMap> a rr:TriplesMap ;
    
    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/Gpa/GruposParlamentaresAmizadeOut" ;
    ] ;

  rr:subjectMap [
      rr:termType rr:IRI ;
      rr:class polis-core:Membership ;
      fnml:functionValue [
          rr:predicateObjectMap [
              rr:predicate fno:executes ;
              rr:objectMap [ rr:constant pofn:hashIri ]
          ] ;
          rr:predicateObjectMap [
              rr:predicate pofn:prefix ;
              rr:objectMap [ rr:constant "urn:membership:" ]
          ] ;
          rr:predicateObjectMap [
              rr:predicate pofn:elements ;
              rr:objectMap [ rml:reference "GplId" ]
          ] ;
          rr:predicateObjectMap [
              rr:predicate pofn:elements ;
              rr:objectMap [ rml:reference "CgaDtini" ]
          ] ;
          rr:predicateObjectMap [
              rr:predicate pofn:elements ;
              rr:objectMap [ rml:reference "CgaDtfim" ]
          ] ;
          rr:predicateObjectMap [
              rr:predicate pofn:elements ;
              rr:objectMap [ rml:reference "CgaCrg" ]
          ]
      ] ;
  ] ;

    # Group
    rr:predicateObjectMap [
        rr:predicate polis-core:isMemberOf ;
        rr:objectMap [
            rr:template "http://purl.org/polis/ar/graph#FriendshipParliamentaryGroup_{GplId}" ;
            rr:termType rr:IRI
        ]
    ] ;

  # Date Period
    rr:predicateObjectMap [
        rr:predicate dct:date ;
        rr:objectMap [
            rr:datatype xsd:string ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:toIso8601Period ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:startDate ;
                    rr:objectMap [
                        fnml:functionValue [
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant pofn:toXsdDateTime ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:inputDateTime ;
                                rr:objectMap [ rml:reference "CgaDtini" ]
                            ]
                        ] ;
                        rr:datatype xsd:dateTime
                    ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:endDate ;
                    rr:objectMap [
                        fnml:functionValue [
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant pofn:toXsdDateTime ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:inputDateTime ;
                                rr:objectMap [ rml:reference "CgaDtfim" ]
                            ]
                        ] ;
                        rr:datatype xsd:dateTime
                    ]
                ]
            ] ;
        ]
    ] ;

    # Role
    rr:predicateObjectMap [
        rr:predicate polis-core:role ;
        rr:objectMap [
            rml:reference "CgaCrg" ;
            rr:datatype xsd:string
        ]
    ] ;
    .

<#FriendshipParliamentaryGroupMap> a rr:TriplesMap ;
    
    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/Gpa/GruposParlamentaresAmizadeOut" ;
    ] ;

    rr:subjectMap [
        rr:template "http://purl.org/polis/ar/graph#FriendshipParliamentaryGroup_{GplId}" ;
        rr:class polis-mpact:FriendshipParliamentaryGroup
    ] ;

    # Identifier
    rr:predicateObjectMap [
        rr:predicate polis-core:identifier ;
        rr:objectMap [ 
            rml:reference "GplId" ;
            rr:datatype xsd:string
        ]
    ] ;

    # Name
    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [ 
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "GplNo" ]
                ]
            ] ;
            rr:datatype xsd:string
        ]
    ] ;

    # Leg
    rr:predicateObjectMap [
        rr:predicate polis-core:belongsToLegislature ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/graph#{GplSelLg}" ;
            rr:termType rr:IRI ;
        ]
    ] ;
    .

<#ParliamentarianPublicAccountRelationMap> a rr:TriplesMap ;
    
    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/Rel/RelatoresContasPublicas/RelatoresContasPublicasOut" ;
    ] ;

    rr:subjectMap [
        rr:template "http://purl.org/polis/ar/graph#Parliamentarian_{../../../../../Deputado/DepCadId}" ;
        rr:class m4s:Parliamentarian
    ] ;

    rr:predicateObjectMap [
        rr:predicate polis-mpact:wasRapporteurIn ;
        rr:objectMap [ 
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:stringConcat ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:leftPart ;
                    rr:objectMap [ rr:constant "http://purl.org/polis/ar/graph#PublicAccount_" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:rightPart ;
                    rr:objectMap [ rml:reference "ActId" ]
                ]
            ]
        ]
    ] ;
    .

<#PublicAccountMap> a rr:TriplesMap ;
    
    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/Rel/RelatoresContasPublicas/RelatoresContasPublicasOut" ;
    ] ;

    rr:subjectMap [
        rr:termType rr:IRI ;
        rr:class polis-mpact:PublicAccount
        ;
        fnml:functionValue [
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant pofn:stringConcat ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:leftPart ;
                rr:objectMap [ rr:constant "http://purl.org/polis/ar/graph#PublicAccount_" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:rightPart ;
                rr:objectMap [ rml:reference "ActId" ]
            ]
        ]
    ] ;

    # Identifier
    rr:predicateObjectMap [
        rr:predicate polis-core:identifier ;
        rr:objectMap [ 
            rml:reference "ActId" ;
            rr:datatype xsd:string
        ]
    ] ;

    # Civil Year
    rr:predicateObjectMap [
        rr:predicate polis-mpact:civilYear ;
        rr:objectMap [ 
