<#PermanentDelegationMap> a rr:TriplesMap ;
    
    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/DlP/DelegacoesPermanentesOut" ;
    ] ;

    rr:subjectMap [
        rr:template "http://purl.org/polis/ar/graph#PermanentDelegation_{DepId}" ;
        rr:class polis-mpact:PermanentDelegation
    ] ;

    # Identifier
    rr:predicateObjectMap [
        rr:predicate polis-core:identifier ;
        rr:objectMap [ 
            rml:reference "DepId" ;
            rr:datatype xsd:string
        ]
    ] ;

    # Name
    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [ 
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "DepNo" ; ]
                ]
            ] ;
            rr:datatype xsd:string
        ]
    ] ;
    
    # Legislature
    rr:predicateObjectMap [
        rr:predicate polis-core:belongsToLegislature ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/graph#{DepSelLg}" ;
            rr:termType rr:IRI ;
        ]
    ] ;

    # Legislative Session
    rr:predicateObjectMap [
        rr:predicate polis-core:belongsToLegislativeSession ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/graph#Session_{DepSelNr}_of_{DepSelLg}" ;
            rr:termType rr:IRI ;
        ]
    ] ;
    .

<#PermanentDelegationMeetingRelationMap> a rr:TriplesMap ;
    
    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/DlP/DelegacoesPermanentesOut/DepReunioes/ReunioesDelegacoesPermanentes" ;
    ] ;

    rr:subjectMap [
        rr:template "http://purl.org/polis/ar/graph#PermanentDelegation_{../../DepId}" ;
        rr:class polis-mpact:PermanentDelegation
    ] ;

    rr:predicateObjectMap [
        rr:predicate polis-mpact:hasPermanentDelegationMeeting ;
        rr:objectMap [ 
            rr:parentTriplesMap <#PermanentDelegationMeetingMap> ;
        ]
    ] ;
    .

<#PermanentDelegationMeetingMap> a rr:TriplesMap ;
    
    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/DlP/DelegacoesPermanentesOut/DepReunioes/ReunioesDelegacoesPermanentes" ;
    ] ;

    rr:subjectMap [
        rr:class polis-mpact:PermanentDelegationMeeting ;
        rr:termType rr:IRI ;
        fnml:functionValue [
            rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant pofn:hashIri ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:prefix ;
                rr:objectMap [ rr:constant "urn:pdm:" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "RenLoc" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "RenDtIni" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "RenDtFim" ]
            ] ;
            rr:predicateObjectMap [
                rr:predicate pofn:elements ;
                rr:objectMap [ rml:reference "RenTi" ]
            ]
        ]
    ] ;

    # Name
    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [ 
            rml:reference "RenTi" ;
            rr:datatype xsd:string
        ]
    ] ;

    # Location
    rr:predicateObjectMap [
        rr:predicate sem:hasPlace ;
        rr:objectMap [ 
            rr:parentTriplesMap <#PermanentDelegationMeetingPlaceMap> ;
        ]
    ] ;

    # Date Period
    rr:predicateObjectMap [
        rr:predicate dct:date ;
        rr:objectMap [
            rr:datatype xsd:string ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:toIso8601Period ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:startDate ;
                    rr:objectMap [
                        rml:reference "RenDtIni" ;
                        rr:datatype xsd:date
                    ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:endDate ;
                    rr:objectMap [
                        rml:reference "RenDtFim" ;
                        rr:datatype xsd:date
                    ]
                ]
            ] ;
        ]
    ] ;
    .

<#TemporaryDelegationMap> a rr:TriplesMap ;
    
    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfAtividadeDeputado/AtividadeDeputado/AtividadeDeputadoList/ActividadeOut/DlE/DelegacoesEventuaisOut" ;
    ] ;

    rr:subjectMap [
        rr:template "http://purl.org/polis/ar/graph#TemporaryDelegation_{DevId}" ;
        rr:class polis-mpact:TemporaryDelegation
    ] ;

    # Identifier
    rr:predicateObjectMap [
        rr:predicate polis-core:identifier ;
        rr:objectMap [ 
            rml:reference "DevId" ;
            rr:datatype xsd:string
        ]
    ] ;

    # Name
    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [ 
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "DevNo" ; ]
                ]
            ] ;
            rr:datatype xsd:string
        ]
    ] ;
    
    # Legislature
    rr:predicateObjectMap [
        rr:predicate polis-core:belongsToLegislature ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/graph#{DevSelLg}" ;
            rr:termType rr:IRI ;
        ]
    ] ;

    # Legislative Session
    rr:predicateObjectMap [
        rr:predicate polis-core:belongsToLegislativeSession ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/graph#Session_{DevSelNr}_of_{DevSelLg}" ;
            rr:termType rr:IRI ;
        ]
    ] ;

    # Date Period (with conversion to xsd:dateTime)
    rr:predicateObjectMap [
        rr:predicate dct:date ;
        rr:objectMap [
            rr:datatype xsd:string ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:toIso8601Period ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:startDate ;
                    rr:objectMap [
                        fnml:functionValue [
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant pofn:toXsdDateTime ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:inputDateTime ;
                                rr:objectMap [ rml:reference "DevDtini" ]
                            ]
                        ] ;
                        rr:datatype xsd:dateTime
                    ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:endDate ;
                    rr:objectMap [
                        fnml:functionValue [
                            rr:predicateObjectMap [
                                rr:predicate fno:executes ;
                                rr:objectMap [ rr:constant pofn:toXsdDateTime ]
                            ] ;
                            rr:predicateObjectMap [
                                rr:predicate pofn:inputDateTime ;
                                rr:objectMap [ rml:reference "DevDtfim" ]
                            ]
                        ] ;
                        rr:datatype xsd:dateTime
                    ]
                ]
            ] ;
        ]
    ] ;

    # Location
    rr:predicateObjectMap [
        rr:predicate sem:hasPlace ;
        rr:objectMap [ 
            rr:parentTriplesMap <#PlaceMap> ;
        ]
    ] ;

    # Scope
    rr:predicateObjectMap [
        rr:predicate polis-mpact:hasDelegationScope ;
        rr:objectMap [ 
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:toClass ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:entityName ;
                    rr:objectMap [ rml:reference "DevTp" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:className ;
                    rr:objectMap [ rr:constant "delegationScope" ]
                ] ;
            ]
        ]
    ] ; 
    .

