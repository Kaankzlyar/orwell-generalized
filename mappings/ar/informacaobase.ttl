@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix rml:    <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:     <http://semweb.mmlab.be/ns/ql#> .
@prefix fnml:   <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno:    <https://w3id.org/function/ontology#> .
@prefix pofn:   <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/Functions#> . # TODO: Update URI to match where the pofn file is hosted
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml:    <http://www.w3.org/XML/1998/namespace> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dbo:    <http://dbpedia.org/ontology/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix ocd:    <http://dati.camera.it/ocd/> .
@prefix m4s:    <https://purl.org/map4scrutiny-core#> .
@prefix schema: <https://schema.org/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix pe:     <https://ukparliament.github.io/ontologies/election/election-ontology.ttl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix polis-ini:    <http://purl.org/polis/ar/initiatives#> .
@prefix polis-bio:    <http://purl.org/polis/ar/biographic#> .
@prefix polis-core:   <http://purl.org/polis/ar/core#> .
@prefix polis-graph:  <http://purl.org/polis/ar/graph#> .

<#LegislatureMap>

  rml:logicalSource [
    rml:source "data/" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "/Legislatura/DetalheLegislatura"
  ] ;

  # URI (Roman numeral in the sigla, e.g. "XIV" -> http://purl.org/polis/ar/core#XIV)
  rr:subjectMap [
    rr:template "http://purl.org/polis/ar/graph#{sigla}";
    rr:class ocd:legislatura
  ] ;

  # Identifier
  rr:predicateObjectMap [
    rr:predicate polis-core:identifier ;
    rr:objectMap [
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:objectMap [ rr:constant pofn:trim ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:inputTrim ;
          rr:objectMap [ rml:reference "id" ]
        ]
      ]
    ]
  ] ;

  # Date range as an ISO 8601 period, e.g. 2024-03-28/2028-03-27
  rr:predicateObjectMap [
    rr:predicate dct:date ;
    rr:objectMap [
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:objectMap [ rr:constant pofn:toIso8601Period ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:startDate ;
          rr:objectMap [
            rml:reference "dtini" ;
            rr:datatype xsd:string
          ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:endDate ;
          rr:objectMap [
            rml:reference "dtfim" ;
            rr:datatype xsd:string
          ]
        ]
      ] ;
      rr:datatype xsd:string
    ]
  ] ;

  # Number (Decimal version of the Roman numeral in the sigla, e.g. "XIV" -> 14)
  rr:predicateObjectMap [
    rr:predicate dbo:number ;
    rr:objectMap [
      rr:datatype xsd:nonNegativeInteger ;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:objectMap [ rr:constant pofn:romanToDecimal ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:romanNumeral ;
          rr:objectMap [
            rml:reference "sigla" ;
            rr:datatype xsd:string
          ]
        ]
      ] ;
    ]
  ] 
  .

<#LegislativeSessionMap>

  rml:logicalSource [
    rml:source "data/" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "/Legislatura/SessoesLegislativas/pt_gov_ar_objectos_SessaoLegislativaOut"
  ] ;

  # URI 
  rr:subjectMap [
    rr:template "http://purl.org/polis/ar/graph#Session_{numSessao}_of_{../../DetalheLegislatura/sigla}" ;
    rr:class ocd:sessioneLegislatura
  ] ;

  # Number
  rr:predicateObjectMap [
    rr:predicate dbo:number ;
    rr:objectMap [
      rml:reference "numSessao" ;
      rr:datatype xsd:nonNegativeInteger
    ]
  ] ;

  # Date Period
  rr:predicateObjectMap [
    rr:predicate dct:date ;
    rr:objectMap [
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:objectMap [ rr:constant pofn:toIso8601Period ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:startDate ;
          rr:objectMap [
            rml:reference "dataInicio" ;
            rr:datatype xsd:string
          ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:endDate ;
          rr:objectMap [
            rml:reference "dataFim" ;
            rr:datatype xsd:string
          ]
        ]
      ] ;
      rr:datatype xsd:string
    ]
  ] ;

  # Legislature
  rr:predicateObjectMap [
    rr:predicate polis-core:belongsToLegislature ;
    rr:objectMap [
      rr:template "http://purl.org/polis/ar/graph#{../../DetalheLegislatura/sigla}" ;
      rr:termType rr:IRI
    ]
  ]
  .

<#ConstituencyMap>

  rml:logicalSource [
    rml:source "data/" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "/Legislatura/CirculosEleitorais/pt_ar_wsgode_objectos_DadosCirculoEleitoralList"
  ] ;

  # URI
  rr:subjectMap [
    rr:template "http://purl.org/polis/ar/graph#Constituency_{cpDes}" ;
    rr:class pe:ConstituencyArea
  ] ;

  # Identifier
  rr:predicateObjectMap [
    rr:predicate polis-core:identifier ;
    rr:objectMap [
      rml:reference "cpId" ;
      rr:datatype xsd:string
    ]
  ] ;

  # Name
  rr:predicateObjectMap [
    rr:predicate foaf:name ;
    rr:objectMap [
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:objectMap [ rr:constant pofn:trim ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:inputTrim ;
          rr:objectMap [ rml:reference "cpDes" ]
        ]
      ]
    ]
  ] ;

  # Legislature
  rr:predicateObjectMap [
    rr:predicate polis-core:belongsToLegislature ;
    rr:objectMap [
      rr:template "http://purl.org/polis/ar/graph#{legDes}" ;
      rr:termType rr:IRI
    ]
  ] ;

  # Linked Data linking to corresponding Wikidata entity
  rr:predicateObjectMap [
    rr:predicate owl:sameAs ;
    rr:objectMap [
      rr:termType rr:IRI ;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:objectMap [ rr:constant pofn:reconciliate ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:query ;
          rr:objectMap [
            rr:template "Círculo {cpDes}" ;
            rr:datatype xsd:string
          ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:type ;
          rr:objectMap [ rr:constant "Q59576414" ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:limit ;
          rr:objectMap [ rr:constant "5"]
        ]
      ]
    ]
  ] 
  .

<#PartyMap>

  rml:logicalSource [
    rml:source "data/" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "/Legislatura/GruposParlamentares/pt_gov_ar_objectos_GPOut"
  ] ;

  # URI
  rr:subjectMap [
    rr:template "http://purl.org/polis/ar/graph#{sigla}" ;
    rr:class polis-core:Party
  ] ;

  # Name
  rr:predicateObjectMap [
    rr:predicate foaf:name ;
    rr:objectMap [
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:objectMap [ rr:constant pofn:trim ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:inputTrim ;
          rr:objectMap [ rml:reference "nome" ]
        ]
      ]
    ]
  ] ;

  # Acronym
    rr:predicateObjectMap [
      rr:predicate qudt:acronym ;
      rr:objectMap [
        fnml:functionValue [
          rr:predicateObjectMap [
            rr:predicate fno:executes ;
            rr:objectMap [ rr:constant pofn:trim ]
          ] ;
          rr:predicateObjectMap [
            rr:predicate pofn:inputTrim ;
            rr:objectMap [ rml:reference "sigla" ]
          ]
        ]
      ]
    ] 
  .

<#ParliamentaryGroupMap>

  rml:logicalSource [
    rml:source "data/" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "/Legislatura/GruposParlamentares/pt_gov_ar_objectos_GPOut"
  ] ;

  # URI
  rr:subjectMap [
    rr:template "http://purl.org/polis/ar/graph#ParliamentaryGroup_{sigla}_of_{../../DetalheLegislatura/sigla}" ;
    rr:class polis-core:ParliamentaryGroup
  ] ;

  # Is of Party
  rr:predicateObjectMap [
    rr:predicate polis-core:isOfParty ;
    rr:objectMap [
      rr:template "http://purl.org/polis/ar/graph#{sigla}" ;
      rr:termType rr:IRI
    ]
  ] ;

    # Date Period
  rr:predicateObjectMap [
    rr:predicate dct:date ;
    rr:objectMap [
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:objectMap [ rr:constant pofn:toIso8601Period ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:startDate ;
          rr:objectMap [
            rml:reference "../../DetalheLegislatura/dtini" ;
            rr:datatype xsd:string
          ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:endDate ;
          rr:objectMap [
            rml:reference "../../DetalheLegislatura/dtfim" ;
            rr:datatype xsd:string
          ]
        ]
      ] ;
      rr:datatype xsd:string
    ]
  ] ;

  # Legislature
  rr:predicateObjectMap [
    rr:predicate polis-core:belongsToLegislature ;
    rr:objectMap [
      rr:template "http://purl.org/polis/ar/graph#{../../DetalheLegislatura/sigla}" ;
      rr:termType rr:IRI
    ]
  ]
  .

<#ParliamentarianMap>

  rml:logicalSource [
    rml:source "data/" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "/Legislatura/Deputados/DadosDeputadoOrgaoPlenario"
  ] ;

  # URI
  rr:subjectMap [
    rr:template "http://purl.org/polis/ar/graph#Parliamentarian_{DepCadId}" ;
    rr:class m4s:Parliamentarian
  ] ;
  
  # Full Name
  rr:predicateObjectMap [
    rr:predicate foaf:name ;
    rr:objectMap [
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:objectMap [ rr:constant pofn:trim ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:inputTrim ;
          rr:objectMap [ rml:reference "DepNomeCompleto" ]
        ]
      ]
    ]
  ] ;

  # Mandate
  rr:predicateObjectMap [
    rr:predicate ocd:rif_mandatoCamera ;
    rr:objectMap [
      rr:template "http://purl.org/polis/ar/graph#Mandate_{DepId}" ;
      rr:termType rr:IRI
    ]
  ] ;

  # Legislature
  rr:predicateObjectMap [
    rr:predicate polis-core:belongsToLegislature ;
    rr:objectMap [
      rr:template "http://purl.org/polis/ar/graph#{../../DetalheLegislatura/sigla}" ;
      rr:termType rr:IRI
    ]
  ]
  .

<#MandateMap>
  rml:logicalSource [
    rml:source "data/" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "/Legislatura/Deputados/DadosDeputadoOrgaoPlenario"
  ] ;

  rr:subjectMap [
    rr:template "http://purl.org/polis/ar/graph#Mandate_{DepId}" ;
    rr:class ocd:mandatoCamera
  ] ;

  # Parliamentary Name
  rr:predicateObjectMap [
    rr:predicate polis-core:parliamentaryName ;
    rr:objectMap [
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:objectMap [ rr:constant pofn:trim ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:inputTrim ;
          rr:objectMap [ rml:reference "DepNomeParlamentar" ]
        ]
      ]
    ]
  ] ;

  # Constituency
  rr:predicateObjectMap [
    rr:predicate polis-core:inConstituency ;
    rr:objectMap [
      rr:template "http://purl.org/polis/ar/graph#Constituency_{DepCPDes}" ;
      rr:termType rr:IRI
    ]
  ] ;

  # Legislature
  rr:predicateObjectMap [
    rr:predicate polis-core:belongsToLegislature ;
    rr:objectMap [
      rr:template "http://purl.org/polis/ar/graph#{LegDes}" ;
      rr:termType rr:IRI
    ]
  ]
  .

<#MandateMembershipRelationMap>

  rml:logicalSource [
    rml:source "data/" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "/Legislatura/Deputados/DadosDeputadoOrgaoPlenario/DepGP/pt_ar_wsgode_objectos_DadosSituacaoGP"
  ] ;

  rr:subjectMap [
    rr:class ocd:mandatoCamera ;
    rr:template "http://purl.org/polis/ar/graph#Mandate_{../../DepId}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate polis-core:hasMembership ;
    rr:objectMap [
      rr:parentTriplesMap <#PGMembershipMap> ;
    ]
  ] ;
  .


<#PGMembershipMap>
  rml:logicalSource [
    rml:source "data/" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "/Legislatura/Deputados/DadosDeputadoOrgaoPlenario/DepGP/pt_ar_wsgode_objectos_DadosSituacaoGP"
  ] ;

  rr:subjectMap [
    rr:termType rr:BlankNode ;
    rr:template "membership-{../../DepId}_{gpSigla}_{gpDtInicio}" ;
    rr:class polis-core:Membership
  ] ;

  # Is Member Of
  rr:predicateObjectMap [
    rr:predicate polis-core:isMemberOf ;
    rr:objectMap [
      rr:template "http://purl.org/polis/ar/graph#{gpSigla}" ;
      rr:termType rr:IRI
    ]
  ] ;

  # Date Period
  rr:predicateObjectMap [
    rr:predicate dct:date ;
    rr:objectMap [
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:objectMap [ rr:constant pofn:toIso8601Period ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:startDate ;
          rr:objectMap [
            rml:reference "gpDtInicio" ;
            rr:datatype xsd:string
          ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:endDate ;
          rr:objectMap [
            rml:reference "gpDtFim" ;
            rr:datatype xsd:string
          ]
        ]
      ] ;
      rr:datatype xsd:string
    ]
  ]
  .


<#MandateSituationRelationMap>
  rml:logicalSource [
    rml:source "data/" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "/Legislatura/Deputados/DadosDeputadoOrgaoPlenario/DepSituacao/pt_ar_wsgode_objectos_DadosSituacaoDeputado"
  ] ;

  rr:subjectMap [
    rr:class ocd:mandatoCamera ;
    rr:template "http://purl.org/polis/ar/graph#Mandate_{../../DepId}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate ocd:tipoProclamazione ;
    rr:objectMap [
      rr:template "http://purl.org/polis/ar/graph#Situation_{sioDes}_{../../DepId}_of_{sioDtInicio}" ;
      rr:termType rr:IRI
    ]
  ] ;
  .

<#SituationMap>
  rml:logicalSource [
    rml:source "data/" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "/Legislatura/Deputados/DadosDeputadoOrgaoPlenario/DepSituacao/pt_ar_wsgode_objectos_DadosSituacaoDeputado"
  ] ;

  # URI
  rr:subjectMap [
    rr:termType rr:IRI ;
    rr:template "http://purl.org/polis/ar/graph#Situation_{sioDes}_{../../DepId}_of_{sioDtInicio}" ;
    rr:class ocd:proclamazione
  ] ;

  # Type of Situation (e.g. "Desístência", "Falecido/a", etc.)
  rr:predicateObjectMap [
    rr:predicate rdf:type ;
    rr:objectMap [
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:objectMap [ rr:constant pofn:toEnglish ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:entityName ;
          rr:objectMap [
            fnml:functionValue [
              rr:predicateObjectMap [
                rr:predicate fno:executes ;
                rr:objectMap [ rr:constant pofn:trim ]
              ] ;
              rr:predicateObjectMap [
                rr:predicate pofn:inputTrim ;
                rr:objectMap [ rml:reference "sioDes" ]
              ]
            ]
          ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:className ;
          rr:objectMap [
            rr:constant "situation" ;
            rr:datatype xsd:string
          ]
        ]
      ] ;
      rr:termType rr:IRI
    ]
  ] ;

  # Label
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:objectMap [ rr:constant pofn:trim ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:inputTrim ;
          rr:objectMap [ rml:reference "sioDes" ]
        ]
      ]
    ]
  ] ;

  # Date Period
  rr:predicateObjectMap [
    rr:predicate dct:date ;
    rr:objectMap [
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:objectMap [ rr:constant pofn:toIso8601Period ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:startDate ;
          rr:objectMap [
            rml:reference "sioDtInicio" ;
            rr:datatype xsd:string
          ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:endDate ;
          rr:objectMap [
            rml:reference "sioDtFim" ;
            rr:datatype xsd:string
          ]
        ]
      ] ;
      rr:datatype xsd:string
    ]
  ] ;
  .

<#MandateDutyRelationMap>
  rml:logicalSource [
    rml:source "data/" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "/Legislatura/Deputados/DadosDeputadoOrgaoPlenario/DepCargo/pt_ar_wsgode_objectos_DadosCargoDeputado"
  ] ;

  rr:subjectMap [
    rr:class ocd:mandatoCamera ;
    rr:template "http://purl.org/polis/ar/graph#Mandate_{../../DepId}"
  ] ;

  rr:predicateObjectMap [
    rr:predicate polis-core:holdsDuty ;
    rr:objectMap [
      rr:parentTriplesMap <#DutyMap> ;
    ]
  ] ;
  .

<#DutyMap>
  rml:logicalSource [
    rml:source "data/" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "/Legislatura/Deputados/DadosDeputadoOrgaoPlenario/DepCargo/pt_ar_wsgode_objectos_DadosCargoDeputado"
  ] ;

  rr:subjectMap [
    rr:termType rr:BlankNode ;
    rr:template "duty-{../../DepId}_of_{carDtInicio}" ;
    rr:class org:Post
  ] ;

  # Type of Duty (e.g. "PAR", "ViceSecretary", etc.)
  rr:predicateObjectMap [
      rr:predicate rdf:type ;
      rr:objectMap [
          fnml:functionValue [
            rr:predicateObjectMap [
              rr:predicate fno:executes ;
              rr:objectMap [ rr:constant pofn:toEnglish ]
            ] ;
            rr:predicateObjectMap [
              rr:predicate pofn:entityName ;
              rr:objectMap [
                fnml:functionValue [
                  rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trim ]
                  ] ;
                  rr:predicateObjectMap [
                    rr:predicate pofn:inputTrim ;
                    rr:objectMap [ rml:reference "carDes" ]
                  ]
                ]
              ]
            ] ;
            rr:predicateObjectMap [
              rr:predicate pofn:className ;
              rr:objectMap [
                rr:constant "duty" ;
                rr:datatype xsd:string
              ]
            ]
          ] ;
      rr:termType rr:IRI
    ]
  ] ;

  # Date Period
  rr:predicateObjectMap [
    rr:predicate dct:date ;
    rr:objectMap [
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:objectMap [ rr:constant pofn:toIso8601Period ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:startDate ;
          rr:objectMap [
            rml:reference "carDtInicio" ;
            rr:datatype xsd:string
          ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:endDate ;
          rr:objectMap [
            rml:reference "carDtFim" ;
            rr:datatype xsd:string
          ]
        ]
      ] ;
      rr:datatype xsd:string
    ]
  ] ;
  .

