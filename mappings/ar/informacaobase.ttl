@prefix rr:       <http://www.w3.org/ns/r2rml#> .
@prefix rml:      <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:       <http://semweb.mmlab.be/ns/ql#> .
@prefix fnml:     <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno:      <https://w3id.org/function/ontology#> .
@prefix pofn:     <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/Functions#> .
@prefix schema:   <https://schema.org/> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix :         <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/InfoBase/> .

<#LegislatureMap>

  rml:logicalSource [
    rml:source "data/" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "/Legislatura/DetalheLegislatura"
  ] ;

  rr:subjectMap [
    rr:template "http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/InfoBase/{sigla}";
    rr:class :Legislature
  ] ;

  rr:predicateObjectMap [
    rr:predicate schema:startDate ;
    rr:objectMap [
      rml:reference "dtini" ;
      rr:datatype xsd:date
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate schema:endDate ;
    rr:objectMap [
      rml:reference "dtfim" ;
      rr:datatype xsd:date
    ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate dcterms:identifier ;
    rr:objectMap [
      rml:reference "id" ;
      rr:datatype xsd:integer
    ]
  ]
  .

<#ElectoralCircleMap>

  rml:logicalSource [
    rml:source "data/" ;
    rml:referenceFormulation ql:XPath ;
    rml:iterator "/Legislatura/CirculosEleitorais/pt_ar_wsgode_objectos_DadosCirculoEleitoralList"
  ] ;

  rr:subjectMap [
    rr:template "http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/InfoBase/{cpDes}" ;
    rr:class :ElectoralCircle
  ] ;

  rr:predicateObjectMap [
    rr:predicate owl:sameAs ;
    rr:objectMap [
      rr:termType rr:IRI ;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes ;
          rr:objectMap [ rr:constant pofn:reconciliate ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:query ;
          rr:objectMap [
            rr:template "Círculo {cpDes}" ;
            rr:datatype xsd:string
          ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:type ;
          rr:objectMap [ rr:constant "Q59576414" ]
        ] ;
        rr:predicateObjectMap [
          rr:predicate pofn:limit ;
          rr:objectMap [ rr:constant "5"]
        ]
      ]
    ]
  ] 
  .
