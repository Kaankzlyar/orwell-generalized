    rr:predicateObjectMap [
        rr:predicate polis-bio:hasTitle ;
        rr:objectMap [
            rr:parentTriplesMap <#TitleMap> ;
        ]
    ] ;
    .

<#TitleMap> a rr:TriplesMap ;

    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfDadosRegistoBiografico/DadosRegistoBiografico/CadTitulos/DadosTitulos"
    ] ;

    # URI
    rr:subjectMap [
        rr:termType rr:BlankNode ;
        rr:template "title-{TitId}" ;
        rr:class polis-bio:Title
    ] ;

    # Identifier
    rr:predicateObjectMap [
        rr:predicate polis-core:identifier ;
        rr:objectMap [ 
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "TitId" ]
                ]
            ] ;
            rr:datatype xsd:string
        ]
    ] ;

    # Name
    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "TitDes" ]
                ]
            ]
        ]
    ] ;

    # Number
    rr:predicateObjectMap [
        rr:predicate dbo:number ;
        rr:objectMap [ 
            rml:reference "TitOrdem" ;
            rr:datatype xsd:nonNegativeInteger
        ]
     ] ;
    .

