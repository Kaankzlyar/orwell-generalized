<#ParliamentarianHabilitationRelationMap>

    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfDadosRegistoBiografico/DadosRegistoBiografico/CadHabilitacoes/DadosHabilitacoes"
    ] ;

    rr:subjectMap [
        rr:class m4s:Parliamentarian ; 
        rr:template "http://purl.org/polis/ar/graph#Parliamentarian_{../../CadId}" ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate polis-bio:hasHabilitation ;
        rr:objectMap [ 
            rr:template "http://purl.org/polis/ar/graph#habilitation-{HabId}" ;
            rr:termType rr:IRI ;
        ]
    ] ;
    .

<#HabilitationMap>

    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfDadosRegistoBiografico/DadosRegistoBiografico/CadHabilitacoes/DadosHabilitacoes"
    ] ;

    # URI
    rr:subjectMap [
        #rr:termType rr:BlankNode ;
        rr:template "http://purl.org/polis/ar/graph#habilitation-{HabId}" ;
        rr:class polis-bio:Habilitation
    ] ;

    # Identifier
    rr:predicateObjectMap [
        rr:predicate polis-core:identifier ;
        rr:objectMap [ 
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "HabId" ]
                ]
            ] ;
            rr:datatype xsd:string
        ]
    ] ;

    # Name
    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "HabDes" ]
                ]
            ]
        ]
    ] ;

    # Level
    rr:predicateObjectMap [
        rr:predicate polis-bio:isHabilitationLevel ;
        rr:objectMap [
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:toHabilitationLevel]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:inputHabilitationLevel ;
                    rr:objectMap [ rml:reference "HabTipoId"]
                ]
            ]
        ] ;
    ] ;

    # Status
    rr:predicateObjectMap [
        rr:predicate polis-bio:hasHabilitationStatus ;
        rr:objectMap [ 
            rr:termType rr:IRI ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:prefixedIri ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:prefix ;
                    rr:objectMap [ rr:constant "http://purl.org/polis/ar/biographic#" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:value ;
                    rr:objectMap [ rml:reference "HabEstado" ]
                ]
            ]
        ]
    ] ;
    .
