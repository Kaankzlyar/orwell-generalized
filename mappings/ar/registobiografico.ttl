@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix rml:    <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:     <http://semweb.mmlab.be/ns/ql#> .
@prefix fnml:   <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno:    <https://w3id.org/function/ontology#> .
@prefix pofn:   <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology/Functions#> . # TODO: Update URI to match where the pofn file is hosted
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml:    <http://www.w3.org/XML/1998/namespace> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dbo:    <http://dbpedia.org/ontology/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix ocd:    <http://dati.camera.it/ocd/> .
@prefix m4s:    <https://purl.org/map4scrutiny-core#> .
@prefix schema: <https://schema.org/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix pe:     <https://ukparliament.github.io/ontologies/election/election-ontology.ttl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix polis-ini:    <http://purl.org/polis/ar/initiatives#> .
@prefix polis-bio:    <http://purl.org/polis/ar/biographic#> .
@prefix polis-core:   <http://purl.org/polis/ar/core#> .

<#ParliamentarianMap>

    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfDadosRegistoBiografico/DadosRegistoBiografico"
    ] ;

    # URI
    rr:subjectMap [
        rr:template "http://purl.org/polis/ar/graph#Parliamentarian_{CadId}" ;
        rr:class m4s:Parliamentarian
    ] ;

    # Birth Date
    rr:predicateObjectMap [
        rr:predicate foaf:birthday ;
        rr:objectMap [ 
            rml:reference "CadDtNascimento" ;
            rr:datatype xsd:date
        ]
    ] ;

    # Gender
    rr:predicateObjectMap [
        rr:predicate schema:gender ;
        rr:objectMap [
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "CadSexo" ]
                ]
            ]
        ]
    ] ;

    # Profession
    rr:predicateObjectMap [
        rr:predicate schema:jobTitle ;
        rr:objectMap [
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "CadProfissao" ]
                ]
            ]
        ]
    ] ;
    .

<#ParliamentarianRoleRelationMap>

    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfDadosRegistoBiografico/DadosRegistoBiografico/CadCargosFuncoes/DadosCargosFuncoes"
    ] ;

    rr:subjectMap [
        rr:class m4s:Parliamentarian ;
        rr:template "http://purl.org/polis/ar/graph#Parliamentarian_{../../CadId}" ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate polis-bio:hasRole ;
        rr:objectMap [ 
            rr:parentTriplesMap <#RoleMap> ;
        ]
    ] ;
    .

<#RoleMap>

    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfDadosRegistoBiografico/DadosRegistoBiografico/CadCargosFuncoes/DadosCargosFuncoes"
    ] ;

    # URI
    rr:subjectMap [
        rr:template "role-{FunId}" ;
        rr:termType rr:BlankNode ;
        rr:class polis-bio:Role
    ] ;

    # Identifier
    rr:predicateObjectMap [
        rr:predicate polis-core:identifier ;
        rr:objectMap [ 
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "FunId" ]
                ]
            ] ;
            rr:datatype xsd:string
        ]
    ] ;

    # Name
    rr:predicateObjectMap [
        rr:predicate foaf:name ;
        rr:objectMap [
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:trimSafe ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "FunDes" ]
                ]
            ]
        ]
    ] ;

    # Number
    rr:predicateObjectMap [
        rr:predicate dbo:number ;
        rr:objectMap [ 
            rml:reference "FunOrdem" ;
            rr:datatype xsd:nonNegativeInteger
        ]
    ] ;

    # Done Before
    rr:predicateObjectMap [
        rr:predicate polis-bio:doneBefore ;
        rr:objectMap [ 
            rr:datatype xsd:boolean ;
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant pofn:toBoolean ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate pofn:stringValue ;
                    rr:objectMap [
                        rml:reference "FunAntiga" ;
                        rr:datatype xsd:string
                    ]
                ] ;
            ]
        ]
    ] ;
    .

<#ParliamentarianTitleRelationMap>

    rml:logicalSource [
        rml:source "data/" ;
        rml:referenceFormulation ql:XPath ;
        rml:iterator "/ArrayOfDadosRegistoBiografico/DadosRegistoBiografico/CadTitulos/DadosTitulos"
