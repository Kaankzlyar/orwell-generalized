@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix :       <http://www.semanticweb.org/tonevanda/ontologies/2026/1/PoliOntology-InfoBase/> .

:LegislatureShape
    a sh:NodeShape ;
    sh:targetClass :Legislature ;
    sh:property [
        sh:path schema:startDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each Legislature must have a starting date"@en, 
            "Cada Legislatura deverá ter uma data de ínicio"@pt ;
    ];

    sh:property [
        sh:path dcterms:identifier ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "Each Legislature must have an identifier"@en,
                    "Cada Legislatura deverá ter um identificador"@pt;
    ]
.