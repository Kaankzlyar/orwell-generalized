---
config:
  layout: elk
---
flowchart LR
    Habilitation["Habilitation<br>(schema:EducationalLevel)"] -- hasIdentifier --> hid["ID<br>(dcterms:identifier)"]
    Habilitation -- hasDescription --> hdes["Description<br>(skos:prefLabel)"]
    Habilitation -- hasType --> htype["Type<br>(skos:Concept)"]
    Habilitation -- hasStatus --> hstatus["Status<br>(skos:Concept)"]

    htype -- skos:inScheme --> htypeEnum["Habilitation Type<br>(skos:ConceptScheme)"]
    ht1["Type 9 (Primary School)"] -.-> htype
    ht2["Type 10 (Middle School)"] -.-> htype
    ht3["Type 11 (Early High School)"] -.-> htype
    ht4["Type 12 (High School)"] -.-> htype
    ht5["Type 13 (Higher Education)"] -.-> htype
    ht6["Type 14 (Bachelor)"] -.-> htype
    ht7["Type 15 (Master)"] -.-> htype
    ht8["Type 16 (Postgrad)"] -.-> htype

    hstatus -- skos:inScheme --> hstatusEnum["Habilitation Status<br>(skos:ConceptScheme)"]
    hs1["C (Completed)"] -.-> hstatus
    hs2["F (Incompleted)"] -.-> hstatus