---
config:
  layout: elk
---
flowchart LR
    Habilitation["Habilitation<br>(schema:EducationalOccupationalCredential)"] -- hasIdentifier --> hid["ID<br>(dcterms:identifier)"]
    Habilitation -- title --> hdes["Title<br>(rdfs:label)"]
    Habilitation -- type --> htype["Type<br>(skos:Concept)"]
    Habilitation -- status --> hstatus["Status<br>(skos:Concept)"]
    
    htype -->|"skos:inScheme"| htypeEnum["Habilitation Type<br>(skos:ConceptScheme)"]
    htypeEnum -.->|"skos:hasTopConcept"| ht5["Type 9 (Primary School)"]
    htypeEnum -.->|"skos:hasTopConcept"| ht7["Type 10 (Middle School)"]
    htypeEnum -.->|"skos:hasTopConcept"| ht8["Type 11 (Early High School)"]
    htypeEnum -.->|"skos:hasTopConcept"| ht1["Type 12 (High School)"]
    htypeEnum -.->|"skos:hasTopConcept"| ht2["Type 13 (Higher Education)"]
    htypeEnum -.->|"skos:hasTopConcept"| ht6["Type 14 (Bachelor)"]
    htypeEnum -.->|"skos:hasTopConcept"| ht3["Type 15 (Master)"]
    htypeEnum -.->|"skos:hasTopConcept"| ht4["Type 16 (Postgrad)"]
    
    hstatus -->|"skos:inScheme"| hstatusEnum["Habilitation Status<br>(skos:ConceptScheme)"]
    hstatusEnum -.->|"skos:hasTopConcept"| hs1["C (Completed)"]
    hstatusEnum -.->|"skos:hasTopConcept"| hs2["F (Incomplete)"]
